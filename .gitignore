# Logs
*.log
logs/
storage/logs/

# PHP / Laravel (services/core)
services/core/vendor/
services/core/node_modules/
services/core/.phpunit.result.cache
services/core/storage/*.key
services/core/public/hot
services/core/public/storage
services/core/bootstrap/cache/*.php

# Node / NestJS (services/gateway)
services/gateway/node_modules/
services/gateway/dist/
services/gateway/coverage/
services/gateway/.env

# Python (services/llm-worker)
services/llm-worker/.venv/
services/llm-worker/__pycache__/
services/llm-worker/*.pyc
services/llm-worker/.pytest_cache/
services/llm-worker/.mypy_cache/
services/llm-worker/.ruff_cache/

# Go (services/practice-runner)
services/practice-runner/bin/
services/practice-runner/tmp/
services/practice-runner/*.exe
services/practice-runner/*.test
services/practice-runner/vendor/

# Sandbox build artifacts
sandbox-images/**/node_modules/

# Shared / misc
*.sqlite
*.sqlite-journal
.phpunit.cache
coverage/
.nyc_output/
