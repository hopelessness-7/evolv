# =============================================================================
# Evolv — общие переменные окружения / shared environment
# Скопируйте: cp .env.example .env
# =============================================================================

COMPOSE_PROJECT_NAME=evolv

# --- Postgres ---
POSTGRES_DB=evolv
POSTGRES_USER=evolv
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Внутренняя авторизация сервисов / Internal service auth ---
# gateway <-> core, core <-> runner
INTERNAL_SERVICE_TOKEN=change_me_long_random_string

# --- Gateway (NestJS) ---
GATEWAY_PORT=3000
JWT_ACCESS_SECRET=change_me_jwt_access_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORE_INTERNAL_URL=http://core:9000

# --- Core (Laravel) ---
APP_NAME=Evolv
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORE_PORT=9000

# --- LLM worker (Python) ---
LLM_WORKER_PORT=8081
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# --- Practice runner (Go) ---
PRACTICE_RUNNER_PORT=8082
SANDBOX_IDLE_TIMEOUT_MIN=10
SANDBOX_DEFAULT_IMAGE=evolv/node-learn:latest
DOCKER_HOST=unix:///var/run/docker.sock

# --- Nginx ---
NGINX_HTTP_PORT=80
